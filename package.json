{
  "name": "stilllight-two-glass-pixi-m1",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5179 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.mts tests/*.test.mjs",
    "test:reference": "node --test reference/original/tests/*.test.mjs",
    "parity:capture": "node scripts/capture-parity.mjs",
    "verify:fast": "npm run build && npm test && npm run test:reference",
    "verify:viewport": "node scripts/verification/verify-viewport-dpr.mjs",
    "verify:context": "node scripts/verification/verify-context-restore.mjs",
    "verify:fallback": "node scripts/verification/verify-canvas-fallback.mjs",
    "verify:idle-raf": "node scripts/verification/verify-idle-raf.mjs",
    "verify:parity": "node scripts/verification/verify-parity-freeze.mjs",
    "verify:pour": "node scripts/verification/verify-pour-states.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:visual": "node scripts/verify-visual.mjs",
    "verify:m1": "node scripts/verify-m1.mjs"
  },
  "dependencies": {
    "pixi.js": "8.18.0"
  },
  "devDependencies": {
    "playwright-core": "^1.55.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
