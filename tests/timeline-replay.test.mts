import test from 'node:test';import assert from 'node:assert/strict';import {StilllightModel} from '../src/core/model.ts';import {HINT_ATTENTION_MS,INVALID_MS,POUR_MS,SELECT_MS,SETTLE_MS,STREAM_END,STREAM_START,TRANSFER_END,TRANSFER_START} from '../src/core/constants.ts';
const T=10000;
test('selection remains 300 ms analytical sampling',()=>{const m=new StilllightModel();m.choose(0,T);const mid=m.sample(T+SELECT_MS/2);assert.ok(mid.glasses[0].pose.y<130);assert.equal(m.isAnimating(),true);m.advanceAfterFrame(T+SELECT_MS);assert.equal(m.selectionPulse,null);assert.equal(m.selected,0);});
test('invalid and hint preserve fixed durations',()=>{const m=new StilllightModel();m.invalid(T);m.advanceAfterFrame(T+INVALID_MS);assert.equal(m.invalidMotion,null);assert.equal(m.busy,false);m.reset();m.hint(T);m.advanceAfterFrame(T+HINT_ATTENTION_MS);assert.equal(m.hintMotion,null);});
test('transfer and stream use original authored windows',()=>{const m=new StilllightModel();assert.equal(m.startPour(T),true);assert.equal(m.sample(T+POUR_MS*(TRANSFER_START-.001)).metrics.transfer,0);assert.ok(Math.abs(m.sample(T+POUR_MS*TRANSFER_END).metrics.transfer-1)<1e-12);assert.equal(m.sample(T+POUR_MS*(STREAM_START-.001)).stream,null);assert.ok(m.sample(T+POUR_MS*(STREAM_START+.001)).stream);assert.equal(m.sample(T+POUR_MS*(STREAM_END+.001)).stream,null);});
test('settling starts on frame that observes pour completion',()=>{const m=new StilllightModel();m.startPour(T);const frame=m.sample(T+POUR_MS);assert.equal(frame.metrics.pourProgress,1);assert.equal(m.settleMotion,null);m.advanceAfterFrame(T+POUR_MS);assert.equal(m.settleMotion?.started,T+POUR_MS);m.advanceAfterFrame(T+POUR_MS+SETTLE_MS);assert.equal(m.settleMotion,null);});
test('RenderFrame keeps stable board/event references until model events change',()=>{const m=new StilllightModel();m.reset();const a=m.sample(T),board=a.board,events=a.events,b=m.sample(T+1);assert.strictEqual(a,b);assert.strictEqual(b.events,events);assert.strictEqual(b.board,board);m.hint(T+2);const c=m.sample(T+2);assert.strictEqual(c,a);assert.notStrictEqual(c.events,events);assert.deepEqual(events,['reset']);assert.deepEqual(c.events,['reset','hint-start']);});
